# エディタ / 実行時に出る物
imgui.ini
dx12_engine.log
dx12_crash*
mcp_screenshot*.png
assets/.texcache/

# ★ build/game は【あえて追跡する】。clone してすぐ遊べることが要件なので、
#   ビルド済みの Game.exe と game.pak をリポジトリに含めている。
#   ただし実行時に出る物だけは除く。
build/game/dx12_engine.log
build/game/dx12_crash*
build/game/settings.json
build/game/imgui.ini
build/game/.texcache/

__pycache__/
*.pyc

# エディタのオートセーブ(作業中の一時ファイル)
assets/scenes/.autosave/
assets/scenes/.diagnostics_snapshot.json
source/*.blend1

# エディタ / IDE の作業ファイル
# ★ build/ は上のコメントの理由で【あえて追跡する】ので、ここには入れない。
out/
*.user
.vs/
*.tmp
assets/.thumbcache/
.mcp.json

# ビルド用の道具の依存(npm install で入れ直せる)
source/ui_icons/node_modules/

# 実行時に書かれる各PC固有の設定(音量・感度・VSync)。人によって違うので追跡しない
settings.json
